<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Notarisation requires the hardened runtime, which by default only lets a
      process load libraries signed by the same team. Folio embeds pdfium and
      extracts it to a cache directory at first run (see src/pdf.rs); that copy
      carries upstream's ad-hoc signature, not ours, so library validation would
      refuse to load it and the app would die on launch. Disabling validation is
      the supported way to allow it, and is accepted by the notary service.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
